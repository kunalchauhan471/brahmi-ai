# Brahmi AI — Cloud Mode
#
# The app runs 100% fine WITHOUT these (Demo Mode / localStorage).
# Add them to enable real cloud storage, sync, and facility logins:
#
#   1. Create a free project at https://supabase.com
#   2. Open Project Settings → API → copy the Project URL & anon public key
#   3. Run the SQL in supabase/schema.sql in Supabase → SQL Editor
#   4. Copy this file to .env.local and fill in your values
#
# Then add the same two variables in Vercel:
#   Project → Settings → Environment Variables

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
